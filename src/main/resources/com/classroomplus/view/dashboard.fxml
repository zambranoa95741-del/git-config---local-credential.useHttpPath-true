<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.classroomplus.controller.DashboardController"
      spacing="16" style="-fx-padding: 24 28 24 28;">

    <VBox spacing="2">
        <Label fx:id="greetingLabel" styleClass="h1"/>
        <Label fx:id="subtitleLabel" styleClass="muted"/>
    </VBox>

    <HBox spacing="16">
        <VBox styleClass="card" spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="totalRooms" styleClass="stat-value"/>
            <Label text="Total rooms" styleClass="muted"/>
        </VBox>
        <VBox styleClass="card" spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="availableNow" styleClass="stat-value, stat-good"/>
            <Label text="Available now" styleClass="muted"/>
        </VBox>
        <VBox styleClass="card" spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="inUseNow" styleClass="stat-value, stat-bad"/>
            <Label text="In use now" styleClass="muted"/>
        </VBox>
        <VBox fx:id="upcomingCard" styleClass="card" spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="upcomingCount" styleClass="stat-value"/>
            <Label text="My upcoming reservations" styleClass="muted"/>
        </VBox>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">

        <VBox styleClass="card" spacing="10" HBox.hgrow="ALWAYS" prefWidth="460">
            <Label text="Rooms right now" styleClass="section-title"/>
            <Label fx:id="hoursNote" styleClass="muted" wrapText="true"/>
            <TableView fx:id="roomTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="roomCol" text="Room" minWidth="70"/>
                    <TableColumn fx:id="buildingCol" text="Building" minWidth="110"/>
                    <TableColumn fx:id="statusCol" text="Status" minWidth="120"/>
                </columns>
                <placeholder>
                    <Label text="No rooms yet." styleClass="muted"/>
                </placeholder>
            </TableView>
        </VBox>

        <VBox fx:id="nextCard" styleClass="card" spacing="10" HBox.hgrow="ALWAYS" prefWidth="460">
            <Label text="My next reservations" styleClass="section-title"/>
            <Label text="Your upcoming and ongoing bookings, soonest first." styleClass="muted"/>
            <TableView fx:id="nextTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="nRoomCol" text="Room" minWidth="110"/>
                    <TableColumn fx:id="nDateCol" text="Date" minWidth="90"/>
                    <TableColumn fx:id="nTimeCol" text="Time" minWidth="120"/>
                    <TableColumn fx:id="nStatusCol" text="Status" minWidth="100"/>
                </columns>
                <placeholder>
                    <Label text="Nothing booked yet. Use Reserve a Room." styleClass="muted"/>
                </placeholder>
            </TableView>
        </VBox>
    </HBox>
</VBox>