<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.classroomplus.controller.MyReservationsController"
      spacing="16" style="-fx-padding: 24 28 24 28;">

    <HBox spacing="16">
        <VBox styleClass="card" spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="upcomingCount" styleClass="stat-value"/>
            <Label text="Upcoming" styleClass="muted"/>
        </VBox>
        <VBox styleClass="card" spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="ongoingCount" styleClass="stat-value"/>
            <Label text="Ongoing" styleClass="muted"/>
        </VBox>
        <VBox styleClass="card" spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="completedCount" styleClass="stat-value"/>
            <Label text="Completed" styleClass="muted"/>
        </VBox>
        <VBox styleClass="card" spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="cancelledCount" styleClass="stat-value"/>
            <Label text="Cancelled" styleClass="muted"/>
        </VBox>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <ComboBox fx:id="statusFilter" prefWidth="200"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="editButton" text="Edit" styleClass="secondary-button"
                disable="true" onAction="#onEdit"/>
        <Button fx:id="cancelButton" text="Cancel reservation" styleClass="danger-button"
                disable="true" onAction="#onCancel"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="roomCol" text="Room" minWidth="140"/>
            <TableColumn fx:id="dateCol" text="Date" minWidth="150"/>
            <TableColumn fx:id="timeCol" text="Time" minWidth="150"/>
            <TableColumn fx:id="purposeCol" text="Purpose" minWidth="180"/>
            <TableColumn fx:id="statusCol" text="Status" minWidth="110"/>
        </columns>
        <placeholder>
            <Label text="No reservations here yet. Use Reserve a Room to make one." styleClass="muted"/>
        </placeholder>
    </TableView>
</VBox>