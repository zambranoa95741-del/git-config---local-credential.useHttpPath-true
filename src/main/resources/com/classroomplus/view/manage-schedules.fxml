<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.classroomplus.controller.ManageSchedulesController"
      spacing="16" style="-fx-padding: 24 28 24 28;">

    <HBox spacing="12" alignment="CENTER_LEFT">
        <ComboBox fx:id="roomFilter" prefWidth="240"/>
        <Label fx:id="countLabel" styleClass="muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Add class" styleClass="primary-button" onAction="#onAdd"/>
        <Button fx:id="editButton" text="Edit" styleClass="secondary-button"
                disable="true" onAction="#onEdit"/>
        <Button fx:id="deleteButton" text="Delete" styleClass="danger-button"
                disable="true" onAction="#onDelete"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="roomCol" text="Room" minWidth="150"/>
            <TableColumn fx:id="dayCol" text="Day" minWidth="100"/>
            <TableColumn fx:id="timeCol" text="Time" minWidth="160"/>
            <TableColumn fx:id="subjectCol" text="Class" minWidth="260"/>
            <TableColumn fx:id="instructorCol" text="Instructor" minWidth="120"/>
        </columns>
        <placeholder>
            <Label text="No classes to show. Click Add class to create one." styleClass="muted"/>
        </placeholder>
    </TableView>
</VBox>