<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.classroomplus.controller.RegisterController"
      styleClass="root-pane">

    <fx:define>
        <ToggleGroup fx:id="roleGroup"/>
    </fx:define>

    <VBox styleClass="brand-panel" alignment="CENTER" spacing="14" prefWidth="420" HBox.hgrow="ALWAYS">
        <ImageView fitHeight="100" preserveRatio="true">
            <image>
                <Image url="@../images/logo-icon.png"/>
            </image>
        </ImageView>
        <Label text="ClassRoom+" styleClass="brand-title"/>
        <Region styleClass="gold-rule" minHeight="3" prefHeight="3" prefWidth="64" maxWidth="64"/>
        <Label text="Create an account to browse classrooms and, for teachers and staff, reserve them."
               styleClass="brand-subtitle" wrapText="true"/>
    </VBox>

    <VBox styleClass="form-panel" alignment="CENTER" prefWidth="680" HBox.hgrow="ALWAYS">
        <VBox spacing="8" maxWidth="420" alignment="CENTER_LEFT">
            <Label text="Create your account" styleClass="h1"/>
            <Label fx:id="introLabel" styleClass="muted" wrapText="true"/>

            <HBox>
                <ToggleButton fx:id="teacherToggle" text="Teacher / Staff" toggleGroup="$roleGroup"
                              selected="true" styleClass="segment-button, segment-left"
                              HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <ToggleButton fx:id="studentToggle" text="Student" toggleGroup="$roleGroup"
                              styleClass="segment-button, segment-right"
                              HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>

            <Label fx:id="idLabel" styleClass="field-label"/>
            <TextField fx:id="idField"/>

            <Label text="Full name" styleClass="field-label"/>
            <TextField fx:id="fullNameField" promptText="e.g. Juan Dela Cruz"/>

            <Label fx:id="departmentLabel" styleClass="field-label"/>
            <TextField fx:id="departmentField"/>

            <Label text="Username" styleClass="field-label"/>
            <TextField fx:id="usernameField" promptText="At least 4 characters, no spaces"/>

            <HBox spacing="10">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Password" styleClass="field-label"/>
                    <PasswordField fx:id="passwordField" promptText="At least 6 characters"/>
                </VBox>
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Confirm password" styleClass="field-label"/>
                    <PasswordField fx:id="confirmField" promptText="Repeat password"/>
                </VBox>
            </HBox>

            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"
                   visible="false" managed="false"/>

            <Button text="Create account" styleClass="primary-button" maxWidth="Infinity"
                    defaultButton="true" onAction="#onCreateAccount"/>

            <HBox alignment="CENTER" spacing="4">
                <Label text="Already have an account?" styleClass="muted"/>
                <Hyperlink text="Sign in" onAction="#onBackToLogin"/>
            </HBox>
        </VBox>
    </VBox>
</HBox>